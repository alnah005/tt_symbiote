# TTNN report root (ttnn.CONFIG.root_report_path defaults to generated/ttnn/reports)
generated/

# Model graph dump written by set_device(..., dump_visualization=True)
# (default output path of tt_symbiote.utils.graph_visualization.draw_model_graph)
model_graph.png

# Per-demo runtime artefacts (auto-generated by examples/e2e/**/run_*.py).
# Phase 8.5 reframed _coverage.json as a pure observation of the most
# recent run, so checking it in would be misleading. Re-generate locally
# by running the per-model demo.
**/*_coverage.json

# Local test fixtures the VLM e2e demos consume. The repo does not ship
# any binary image because we don't own redistribution rights to the
# canonical "dog" photo. Users must drop their own image at
# tests/images/test-dog.png (any format Pillow can decode) to run the
# VLM scripts in examples/e2e/{gemma4,qwen3_vl}/. The scripts skip
# cleanly with a clear message if the file is absent. See
# examples/e2e/README.md for the contract.
tests/images/

# pi0.5 local scratch (profiling/experiment drivers + generated reports + design md)
tests/models/pi05/exp_*.py
tests/models/pi05/profile_bs_ab_pi05.py
tests/models/pi05/profile_e2e_1step_pi05.py
tests/models/pi05/profile_qkv_input_probe.py
